# Airflow image. The DataTrust dependencies (PySpark, dbt, DuckDB) live in a separate virtualenv
# so they cannot conflict with Airflow's pinned dependencies; DAG tasks call that interpreter.
FROM apache/airflow:2.9.3-python3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

USER airflow
COPY requirements.txt /tmp/requirements.txt
RUN python -m venv /opt/airflow/datatrust-venv \
    && /opt/airflow/datatrust-venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt
