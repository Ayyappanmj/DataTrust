# Copy to .env and edit. Placeholders only - never commit real credentials.
DATATRUST_DATA_ROOT=./data
# sqlite (lightweight, default) or postgres (explicit; no silent fallback)
DATATRUST_METADATA_BACKEND=sqlite
DATATRUST_PG_HOST=localhost
DATATRUST_PG_PORT=5432
DATATRUST_PG_DB=datatrust
DATATRUST_PG_USER=datatrust
DATATRUST_PG_PASSWORD=change-me
# Spark
DATATRUST_SPARK_MASTER=local[2]
DATATRUST_SPARK_DRIVER_MEMORY=2g
DATATRUST_SHUFFLE_PARTITIONS=8
# Processing policy
DATATRUST_PARTITION_SCHEME=daily        # daily | monthly
DATATRUST_UNEXPECTED_COLUMNS=warn       # warn | fail | ignore
DATATRUST_FAIL_ON_SEVERITY=CRITICAL     # INFO | WARNING | ERROR | CRITICAL
DATATRUST_ON_FILE_ERROR=continue        # continue | abort
DATATRUST_CSV_DELIMITER=,
DATATRUST_MODELING_ENGINE=duckdb        # duckdb (renders dbt SQL) | dbt (runs dbt-core)
DATATRUST_LOG_LEVEL=INFO
DATATRUST_LOG_JSON=false
# docker-compose / Airflow (placeholders)
POSTGRES_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_FERNET_KEY=generate-with-python-cryptography-Fernet.generate_key
